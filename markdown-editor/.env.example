# Full URL of the markdown files endpoint.
#
# Usually leave this EMPTY: the app builds the URL from the API base the FastAPI
# webapp controller injects at serve time, so it follows the deployment rather
# than the machine that ran `vite build`.
#
# Set it only for a standalone deployment whose API is on another origin, e.g.
# VITE_MARKDOWN_API_URL=https://api.example.com/api/v1/markdown/files
VITE_MARKDOWN_API_URL=

# NOTE: there is deliberately no VITE_MARKDOWN_ADMIN_KEY. The admin key is
# checked by the backend (MARKDOWN_ADMIN_KEY) against what the user types;
# putting it here would compile it into the JavaScript every visitor downloads.
