# Root of the API, including the backend's API_PREFIX if it sets one.
#
# These two settings must agree. The backend mounts its routers under
# settings.API_PREFIX (backend/fastapi/.env), which ships empty:
#
#   API_PREFIX=            ->  VITE_API_BASE_URL=http://localhost:6789
#   API_PREFIX=/api/v1     ->  VITE_API_BASE_URL=http://localhost:6789/api/v1
VITE_API_BASE_URL=http://localhost:6789
