# Base URL of the FastAPI bridge.
# Leave empty in development: vite.config.ts proxies /mongoadmin to VITE_DEV_API_TARGET.
# In production set the full API root, including the backend API_PREFIX if it has one,
# e.g. VITE_API_BASE=https://api.example.com/api/v1
VITE_API_BASE=

# Where the dev server proxies API calls to.
VITE_DEV_API_TARGET=http://localhost:6789
