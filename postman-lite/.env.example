# Base URL of the FastAPI bridge.
#
# Usually leave this EMPTY. When the build is served from the FastAPI web-app
# collection the server injects the live API prefix into the page, and that wins
# over anything set here -- which is the point: a value baked in at build time is
# a value from the build machine, not from the deployment.
#
# In development vite.config.ts proxies to VITE_DEV_API_TARGET, so empty is right
# there too. Set it only for a standalone deployment whose API is on another
# origin, e.g. VITE_API_BASE=https://api.example.com/api/v1
VITE_API_BASE=

# Where the dev server proxies API calls to.
VITE_DEV_API_TARGET=http://localhost:6789
