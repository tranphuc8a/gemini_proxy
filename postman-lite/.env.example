# Base URL of the FastAPI bridge (/proxy and /postman live below it).
# Leave empty in development: vite.config.ts proxies to VITE_DEV_API_TARGET, and
# at runtime the app probes the usual mount points ("", /api/v1, /api) anyway.
# Set it explicitly when the API lives on another origin, e.g.
#   VITE_API_BASE=https://api.example.com/api/v1
VITE_API_BASE=

# Where the dev server proxies API calls to.
VITE_DEV_API_TARGET=http://localhost:6789
