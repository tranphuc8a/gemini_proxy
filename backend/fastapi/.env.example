### Example environment variables for the FastAPI project
# Copy this file to `.env` (in the same folder) and set real secrets before running.

# Database (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gemini_proxy_db
DB_USERNAME=root
DB_PASSWORD=

# App
APP_PORT=6789
# Mount point for every API router. Whatever you set here must be reflected in
# the frontend's VITE_API_BASE_URL.
API_PREFIX=/api/v1

# JWT / security
JWT_SECRET=

# Gemini API (set these if you have an API endpoint/key)
GEMINI_URL=
GEMINI_API_KEY=
# Ceiling for one Gemini call. The web client's HTTP timeout is matched to this
# value, so raising it here without raising it there makes long answers abort in
# the browser while the server is still working.
GEMINI_TIMEOUT_SECONDS=300

# When True the application will prefer an in-memory SQLite DB (useful for tests)
TESTING=false

# HTTP forward proxy used by the postman-lite web app (/api/v1/proxy/request).
# It lets the browser reach APIs that send no CORS headers. Anything the backend
# can reach becomes reachable through it, so set PROXY_ENABLED=false or pin
# PROXY_ALLOWED_HOSTS when this API is exposed publicly.
PROXY_ENABLED=true
# "*" or a comma-separated list of hostname patterns, e.g. "api.example.com,*.internal"
PROXY_ALLOWED_HOSTS=*
PROXY_TIMEOUT_SECONDS=60
PROXY_MAX_BYTES=10485760
PROXY_VERIFY_TLS=false
