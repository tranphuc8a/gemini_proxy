### Example environment variables for the FastAPI project
# Copy this file to `.env` (in the same folder) and set real secrets before running.

# Database (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gemini_proxy_db
DB_USERNAME=root
DB_PASSWORD=
# A full SQLAlchemy *async* URL that overrides the five DB_* values above. Use it
# when the production MySQL is not reachable from your machine, e.g. to run the
# app and the course pages against a local file:
#   DB_URL=sqlite+aiosqlite:///data/dev.sqlite3
# Leave empty to use DB_* (MySQL through aiomysql).
DB_URL=

# App
APP_PORT=6789
# Mount point for every API router. Whatever you set here must be reflected in
# the frontend's VITE_API_BASE_URL.
API_PREFIX=/api/v1

# JWT / security
JWT_SECRET=

# Gemini API (set these if you have an API endpoint/key)
GEMINI_URL=
GEMINI_API_KEY=
# Ceiling for one Gemini call. The web client's HTTP timeout is matched to this
# value, so raising it here without raising it there makes long answers abort in
# the browser while the server is still working.
GEMINI_TIMEOUT_SECONDS=300
# Optional LiteLLM proxy (takes precedence over the direct Gemini endpoint when set).
# The API base may include /v1; the backend adds it when absent.
LITELLM_API_BASE=
# Must match general_settings.master_key in the LiteLLM proxy configuration.
LITELLM_MASTER_KEY=
# LiteLLM proxy only: configure a persistent database (PostgreSQL recommended)
# to enable virtual-key generation; this variable is not used by FastAPI.
LITELLM_DATABASE_URL=
# LiteLLM proxy only: Hive provider credential used by litellm-hive.yaml.
HIVE_API_KEY=

# When True the application will prefer an in-memory SQLite DB (useful for tests)
TESTING=false

# HTTP forward proxy used by the postman-lite web app (/api/v1/proxy/request).
# It lets the browser reach APIs that send no CORS headers. Anything the backend
# can reach becomes reachable through it, so set PROXY_ENABLED=false or pin
# PROXY_ALLOWED_HOSTS when this API is exposed publicly.
PROXY_ENABLED=true
# "*" or a comma-separated list of hostname patterns, e.g. "api.example.com,*.internal"
PROXY_ALLOWED_HOSTS=*
PROXY_TIMEOUT_SECONDS=60
PROXY_MAX_BYTES=10485760
PROXY_VERIFY_TLS=false

# postman-lite-pro workspace sync (/api/v1/postman/*)
# json  = one file, no database needed (default)
# mysql = tables created on first use; no Alembic migration involved
POSTMAN_STORAGE_BACKEND=json
POSTMAN_JSON_FILE=data/postman-workspaces.json
POSTMAN_MAX_HISTORY=500

# Personal spending app (/api/v1/spending/*) -- one JSON document per workspace
# json / mysql / mongo as above (mongo needs MONGO_URI)
SPENDING_STORAGE_BACKEND=json
SPENDING_JSON_FILE=data/spending-workspaces.json
# Largest document a workspace may hold (bytes). Vercel rejects request bodies
# over 4.5 MB, so do not raise this above ~4_000_000 there.
SPENDING_MAX_BYTES=4000000

# ---------------------------------------------------------------------------
# Run source code (/api/v1/run/*) -- Code Studio
# ---------------------------------------------------------------------------
# The backend is normally serverless (no compiler, no sandbox), so code runs at a
# provider the USER picks per request, by id (never by URL). docs/code-studio-api.md
RUN_ENABLED=true
RUN_DEFAULT_PROVIDER=wandbox
# Piston. Empty = not configured. The public emkc.org instance is whitelist-only since 2026-02-15,
# so run your own (see the docs) and put its address here, e.g. http://localhost:2000/api/v2
RUN_PISTON_URL=
RUN_PISTON_KEY=
# Judge0 CE. Empty URL = not configured. Self-hosted Judge0 with AUTHN_TOKEN set
# expects the key in the header named below. RUN_JUDGE0_LANGUAGE_IDS overrides
# language ids that differ between releases, e.g. cpp=105,c=103,python=100
# Verified (2026-10) with the free public instance: RUN_JUDGE0_URL=https://ce.judge0.com (rate-limited, for light use)
RUN_JUDGE0_URL=
RUN_JUDGE0_KEY=
RUN_JUDGE0_KEY_HEADER=X-Auth-Token
RUN_JUDGE0_LANGUAGE_IDS=
# Wandbox needs no key. RUN_WANDBOX_COMPILERS overrides compiler names Wandbox
# has retired, e.g. cpp=gcc-head,python=cpython-head
RUN_WANDBOX_URL=https://wandbox.org/api
RUN_WANDBOX_COMPILERS=
# `local` runs code with the programs installed on THIS machine. IT IS NOT A
# SANDBOX: the code runs as the user the backend runs as. Leave it false on any
# server that people you do not trust can reach. When true it still needs an
# administrator session (COURSE_ADMIN_KEY).
RUN_LOCAL_ENABLED=false
# Where `local` looks for its tools (empty = search PATH): g++, gcc, javac, java, python, node
RUN_LOCAL_GCC=
RUN_LOCAL_GXX=
RUN_LOCAL_JAVAC=
RUN_LOCAL_JAVA=
RUN_LOCAL_PYTHON=
RUN_LOCAL_NODE=
# Runs per minute per client address (administrators are exempt)
RUN_RATE_PER_MIN=20
# Ceiling (seconds) for one HTTP call to a remote provider
RUN_HTTP_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Where the rate limits of /run, /codestore and /wiki are counted
# ---------------------------------------------------------------------------
# The backend runs on several serverless instances that cannot see each other's memory,
# so a limit kept in memory only slows an attacker down. Values:
#   memory   - per process (development, tests)
#   database - table `rate_limit_hits` in the application's SQL database (created on first use)
#   mongo    - collection `rate_limits` in MONGO_URI (TTL index); never chosen by `auto`
#   auto     - `database` when the database is a real MySQL (DB_URL not sqlite, or DB_* fields) and this is
#              not a test run; otherwise `memory`
# If the shared counter fails the request is still served: a warning is logged and that instance counts
# in memory for 30 s. The /ai/* limits stay in memory.
RATE_LIMIT_BACKEND=auto
# Seconds one call to the shared counter may take before it counts as failed
RATE_LIMIT_TIMEOUT_S=2

# ---------------------------------------------------------------------------
# Code Studio store (/api/v1/codestore/*) -- snippets and projects synced between devices
# ---------------------------------------------------------------------------
# json / mysql / mongo as above; tables / collections are created on first use.
CODESTORE_STORAGE_BACKEND=json
CODESTORE_JSON_FILE=data/codestore.json
# Records (snippets, projects, deletion tombstones) per workspace
CODESTORE_MAX_ITEMS=2000
# New workspaces per client address per hour
CODESTORE_WORKSPACES_PER_HOUR=10
# A deletion tombstone is kept this many days, then may be dropped to make room
CODESTORE_TOMBSTONE_DAYS=90
# Read-only share links one workspace may have active at once
CODESTORE_MAX_SHARES=50
# Public reads of a share link per client address per minute (wrong tokens: 20 per 10 minutes)
CODESTORE_SHARE_READS_PER_MIN=120

# ---------------------------------------------------------------------------
# Personal Wiki store (/api/v1/wiki/*) -- notes and flash cards synced between devices
# ---------------------------------------------------------------------------
# json / mysql / mongo as above; tables (wiki_workspaces, wiki_items) / collections are created on first use.
WIKI_STORAGE_BACKEND=json
WIKI_JSON_FILE=data/wiki.json
# Records (notes, cards, deletion tombstones) per workspace
WIKI_MAX_ITEMS=300000
# New workspaces per client address per hour
WIKI_WORKSPACES_PER_HOUR=10
# A deletion tombstone is kept this many days, then may be dropped to make room
WIKI_TOMBSTONE_DAYS=90

# mongo-administrator bridge (/api/v1/mongoadmin/*)
# Sessions stay valid until the user logs out, so the connection URI — which
# carries the password — is sealed with this key before it is written to disk.
# CHANGE THIS before any shared deployment; rotating it logs everybody out.
MONGOADMIN_SECRET_KEY=change-me-mongoadmin
MONGOADMIN_SESSION_FILE=data/mongoadmin-sessions.json
MONGOADMIN_PERSIST_SESSIONS=true    # false keeps sessions in memory only
MONGOADMIN_CONNECT_TIMEOUT=10       # seconds to reach the deployment
MONGOADMIN_OPERATION_TIMEOUT=60     # seconds before an operation is abandoned
MONGOADMIN_POOL_SIZE=10             # pooled connections per session
MONGOADMIN_MAX_DOCUMENTS=1000       # hard cap on documents returned by one call

# ---------------------------------------------------------------------------
# Where JSON data files are written
# ---------------------------------------------------------------------------
# Every JSON-file store (postman workspaces, markdown documents, graphuc
# drawings, the administrator session mirrors) resolves its path through
# src/application/utils/data_paths.py.
#
# Leave DATA_DIR empty and the process probes for a writable location: ./data
# normally, and the system temp directory when ./data cannot be written to.
# That fallback is what makes the apps work on a serverless platform such as
# Vercel, which unpacks the deployment into a READ-ONLY /var/task and only lets
# /tmp be written -- the cause of "[Errno 30] Read-only file system".
#
# IMPORTANT: on such a platform /tmp lives only as long as the instance and is
# not shared between instances, so the JSON backend there is a scratchpad, not
# storage. Use the mysql or mongo backend for anything that must survive.
# Set DATA_DIR explicitly when a persistent volume is mounted.
DATA_DIR=

# ---------------------------------------------------------------------------
# This deployment's own MongoDB — the "mongo" storage backend of the editor apps
# ---------------------------------------------------------------------------
# Unrelated to MONGOADMIN_* above, which is a bridge to whatever server a
# mongo-administrator user logs into. Leave MONGO_URI empty and the mongo
# backend simply reports itself as unavailable in each app's storage picker.
MONGO_URI=
MONGO_DATABASE=gemini_proxy
MONGO_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# markdown-editor document store (/api/v1/markdown/*)
# ---------------------------------------------------------------------------
# json | mysql | mongo — also selectable per request with ?backend=
MARKDOWN_STORAGE_BACKEND=json
MARKDOWN_JSON_FILE=data/markdown-files.json
# The key the editor asks for before it will let anyone save. It is never sent
# to the browser: it is exchanged for a signed session token, so a reload keeps
# the user unlocked without the key ever being stored client-side.
# Rotating this key invalidates every outstanding session.
# Any length that fits an HTTP header works (the key travels in X-Admin-Key; ~8 KB behind
# Vercel). A key that is too long for the header could never be typed in, so keep it under
# a few hundred characters; 32-64 random characters is plenty.
# The value below is PUBLIC (it is in the repository): the server accepts it only
# from this machine itself (loopback, no proxy header). Set your own on any
# deployment, or MARKDOWN_ALLOW_DEFAULT_KEY=true to accept it from anywhere (unsafe).
MARKDOWN_ADMIN_KEY=markdown-editor-admin-2024
MARKDOWN_ALLOW_DEFAULT_KEY=false
MARKDOWN_SESSION_HOURS=12
# Wrong admin keys per client address before the API answers 429 for a while.
# "Client address" = X-Real-IP / X-Forwarded-For when present (Vercel's documentation says the
# platform sets/overwrites both, so they cannot be spoofed there). Self-hosted: put a proxy in
# front that OVERWRITES them, or anyone can dodge this counter - or burn it on somebody else's
# address - by sending the header.
MARKDOWN_ADMIN_MAX_FAILURES=20
MARKDOWN_ADMIN_FAILURE_WINDOW_S=600
# false = the stored documents are private: GET /markdown/files, /markdown/sync/changes
# and /markdown/docs/{id} need the admin session too (history is admin-only either way).
# true = anyone may read them (the behaviour before 10/2026).
MARKDOWN_PUBLIC_READ=true
# Read-only share links: the snapshot is stored in the same backend as the
# documents (MARKDOWN_STORAGE_BACKEND / ?backend=). On a serverless platform
# use mysql or mongo - the json file lives in a temporary directory there.
# markdown_shares is created on first use (CREATE TABLE IF NOT EXISTS) - by the first request
# of any kind that reaches that store in a process, a guest's read of a link included.
MARKDOWN_SHARES_JSON_FILE=data/markdown-shares.json
MARKDOWN_MAX_SHARES=50
MARKDOWN_SHARE_READS_PER_MIN=120
# UTF-8 bytes of one snapshot. Keep <= 2000000 (Vercel body limit 4.5 MB).
MARKDOWN_SHARE_MAX_BYTES=2000000
# Delta sync (/markdown/sync/*, /markdown/docs/*): one record per node, with
# version history. markdown_docs, markdown_doc_revisions and markdown_meta are
# created on first use. Keep the two sizes <= 3500000 / 4000000 (Vercel 4.5 MB).
MARKDOWN_DOCS_JSON_FILE=data/markdown-docs.json
MARKDOWN_DOC_MAX_BYTES=3500000
MARKDOWN_PUSH_MAX_BYTES=4000000
MARKDOWN_MAX_DOCS=20000
# reject (default since the new editor shipped, M4b) = once the first sync has copied the old
# store, the old editor's whole-tree PUT /markdown/files gets 409 md_legacy_client and GET /files
# rebuilds the tree from the synced documents. allow = the old editor keeps working on the old
# store (which the new editor no longer reads). Anything else counts as reject.
MARKDOWN_LEGACY_PUT=reject
# History per document: newest 50 + the newest of each day for 90 days + named ones;
# one device's edits within 600 s share a row; days are cut in this UTC offset.
MARKDOWN_HISTORY_KEEP_RECENT=50
MARKDOWN_HISTORY_DAILY_DAYS=90
MARKDOWN_HISTORY_COALESCE_S=600
MARKDOWN_HISTORY_TZ=+07:00
MARKDOWN_TOMBSTONE_DAYS=90

# ---------------------------------------------------------------------------
# graphuc graph drawings (/api/v1/graphs/*)
# ---------------------------------------------------------------------------
# Reading is open; saving and deleting need the admin key (or a session token
# exchanged for it), exactly as the markdown editor does.
GRAPHUC_STORAGE_BACKEND=json
GRAPHUC_JSON_FILE=data/graphuc-graphs.json
GRAPHUC_ADMIN_KEY=graphuc-admin-2024
GRAPHUC_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Where the two administrators keep their login sessions
# ---------------------------------------------------------------------------
# json | mysql | mongo. Sessions last until the user logs out; the only question
# is whether the mirror survives a restart.
#
# "json" writes a file. On a serverless platform that file lives in a
# per-instance temp directory (see DATA_DIR above), so the next request lands on
# another instance, finds no session, and the user is asked to log in again.
# That is the "phải đăng nhập lại liên tục" bug. Use mysql or mongo there.
#
# Whichever is chosen, the credential inside each record is already sealed with
# AES-GCM before it is written, so the table never holds a readable password.
ADMIN_SESSION_BACKEND=json

# ---------------------------------------------------------------------------
# Course content (/courses/* and the pages under webapp/courses/)
# ---------------------------------------------------------------------------
# Lessons live in the database (tables courses, course_sections, course_groups,
# course_docs — migration 0003; course_assets, course_doc_revisions, course_trash
# — migration 0004). Reading is public; importing, editing,
# publishing and deleting need this key, exchanged for a session token exactly
# like the markdown editor. Rotating it revokes every open session.
# EMPTY = administration switched off (every write answers 403). Use a long
# random value:  python -c "import secrets; print(secrets.token_urlsafe(32))"
COURSE_ADMIN_KEY=
COURSE_SESSION_HOURS=12
# A session can be refreshed until this many days after the login, then the
# key is asked again — a stolen token cannot be kept alive forever.
COURSE_SESSION_MAX_DAYS=7
# GET /courses/{slug}/bundle returns a whole course in one response — right for a
# small structured course (OPIc, ~250 KB), wrong for an 8 MB one, which must be
# read through /manifest + /docs/{id}. Above this many bytes of markdown the
# public bundle endpoint refuses (admins can still export).
COURSE_BULK_MAX_BYTES=2097152
# One lesson's markdown, and one uploaded file (image, pdf…) — both well under
# Vercel's 4.5 MB request body, so an oversized save fails with a clear 413
# instead of the platform cutting the request.
COURSE_DOC_MAX_BYTES=1048576
COURSE_ASSET_MAX_BYTES=3145728
# Wrong admin keys: this many per address within the window, or this many in
# total, and /courses/admin/verify answers 429 (Retry-After) until it passes.
COURSE_LOGIN_FAILURES=5
COURSE_LOGIN_FAILURES_GLOBAL=50
COURSE_LOGIN_WINDOW_SECONDS=300
# Load the bundled courses into the database once (writes to a non-SQLite DB need --yes):
#   python tools/manage_courses.py import-all --yes

# ---------------------------------------------------------------------------
# AI features (/ai/*) and the chat (/gemini/*) — one guarded model quota
# ---------------------------------------------------------------------------
# Tutor beside a lesson, flashcards, course drafting, OPIc speaking feedback,
# natural-language SQL… and chat share the configured provider and usage limits.
# Every call goes through the same door: a kill switch, per-address limits, a
# per-day budget for the whole deployment (counted in the database, tables
# ai_usage + ai_cache — migration 0005), and books the administrator reads in
# the course management page (🤖 AI).
# false stops every model call, the chat included.
AI_ENABLED=true
# Who may use the AI features (Gemini Chat keeps its public access):
#   admin  — a course administrator only (default; log in to the management page once)
#   code   — anyone who enters AI_ACCESS_CODE (exchanged for a token), and admins
#   public — anyone; the limits below still apply
AI_ACCESS=admin
# Changing the code revokes every token issued for the old one.
AI_ACCESS_CODE=
AI_SESSION_DAYS=7
# Default model name: Gemini model for direct mode or a LiteLLM proxy model alias.
AI_MODEL=gemini-3.5-flash
# Models a caller may pick (header X-AI-Model). Empty = provider model list; otherwise comma-separated aliases.
AI_MODELS=
AI_MODELS_TTL_SECONDS=21600
AI_TIMEOUT_SECONDS=90
# Per client address (administrators are exempt).
AI_RATE_PER_MINUTE=12
AI_RATE_PER_DAY=200
# For the whole deployment per UTC day; once either is spent every model call
# answers 429 until midnight UTC (07:00 in Vietnam).
AI_DAILY_REQUESTS=500
AI_DAILY_TOKENS=3000000
